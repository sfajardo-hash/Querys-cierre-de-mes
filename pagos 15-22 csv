SELECT *
FROM `quipumarket-c956f.Data.Pagos`
WHERE base IN ('v15', 'v16', 'v17', 'v18', 'v19', 'v20', 'v21','v22')
ORDER BY
    CASE 
      WHEN base = 'v15' THEN 1
      WHEN base = 'v16' THEN 2
      WHEN base = 'v17' THEN 3
      WHEN base = 'v18' THEN 4
      WHEN base = 'v19' THEN 5
      WHEN base = 'v20' THEN 6
      WHEN base = 'v21' THEN 7
      WHEN base = 'v22' THEN 8
    END,
  orden ASC,
  numero_cuota ASC
