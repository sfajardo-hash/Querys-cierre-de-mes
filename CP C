SELECT
  base,
  codigo_credito,
  id_cliente,
  fecha_desembolso,
  numero_cuota,
  plazo,
  ti_mensual,
  monto_de_credito,
  fuente_de_financiacion,
  fondo_de_deuda,
  fecha_t_pago,
  cuota_t,
  cuota_a_pagar,
  digitalizacion_mensual,
  fecha_pago,
  valor_pagado,
  saldo_capital,
  abono_k,
  abono_int,
  fecha_de_pago_sig,
  valor_pagado_sig_cuota,
  abono_fee,
  saldo_p_cuota,
  pago_cuota,
  dias_retraso,
  gastos_cobranza,
  int_mora,
  monto_int_mora,
  edad_mora_cuota,
  fecha_reclamacion,
  valor_reclamacion,
  fee_reclamacion,
  intereses_reclamacion,
  abono_k_reclamacion,
  fecha_retanqueo,
  valor_retanqueo,
  fee_retanqueo,
  intereses_retanqueo,
  abono_k_retanqueo,
  dias_cosecha,
  estatus_credito,
  pago_total_credito,
  saldo_k_r_r,
  condonaciones
FROM `quipumarket-c956f.Data.Pagos`
WHERE base IN ('v15', 'v16', 'v17', 'v18', 'v19', 'v20', 'v21','v22')
ORDER BY
  CASE 
    WHEN base = 'v15' THEN 1
    WHEN base = 'v16' THEN 2
    WHEN base = 'v17' THEN 3
    WHEN base = 'v18' THEN 4
    WHEN base = 'v19' THEN 5
    WHEN base = 'v20' THEN 6
    WHEN base = 'v21' THEN 7
    WHEN base = 'v22' THEN 8
  END,
  orden ASC,
  numero_cuota ASC
